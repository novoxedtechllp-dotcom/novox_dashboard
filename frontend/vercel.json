
{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/scraper-api/:path*",
      "destination": "https://novox-job-scraper.onrender.com/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://novox-dashboard-9vir.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
